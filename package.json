{
  "name": "aurorarepos-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Anonymous read-only MCP server for Aurora Repos",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aurorarepos-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "pnpm build && vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "smoke:live": "pnpm build && tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "html-to-text": "10.0.1",
    "tough-cookie": "6.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "^22.20.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
